{
  "name": "replofy-os",
  "private": true,
  "version": "0.1.0-dev",
  "description": "An open-source operating system for planning, execution, content, growth, and AI-assisted operations.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibrofk/replofy-os.git"
  },
  "bugs": {
    "url": "https://github.com/ibrofk/replofy-os/issues"
  },
  "homepage": "https://github.com/ibrofk/replofy-os#readme",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "brace-expansion": "^2.1.4",
    "@hono/node-server": "^2.0.12",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.3.1",
    "nanoid": "^3.3.17",
    "esbuild": "^0.25.12",
    "hono": "^4.13.1",
    "postcss": "^8.5.26",
    "uuid": "^11.1.1"
  },
  "type": "module",
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "check:public-surface": "node scripts/check-public-surface.mjs",
    "check:public-safety": "node scripts/check-public-safety.mjs",
    "check:public-safety:history": "node scripts/check-public-safety-history.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check": "npm run check:public-surface && npm run check:public-safety && npm run check:licenses && npm run check:dependencies && npm run lint && npm run test:api-key-scopes && npm run test:context-routing && npm run test:mcp:hosted",
    "dev": "vite --port=4000 --host=0.0.0.0",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:standalone": "node scripts/dev-standalone.mjs",
    "server:dev": "tsx watch src/server/index.ts",
    "server:build": "tsc --project tsconfig.server.json",
    "server:migrate": "node dist-server/src/server/migrate.js",
    "server:start": "node dist-server/src/server/index.js",
    "backup:postgres": "node scripts/postgres-backup.mjs",
    "restore:postgres": "node scripts/postgres-restore.mjs",
    "backup:standalone": "node scripts/backup-standalone.mjs",
    "restore:standalone": "node scripts/restore-standalone.mjs",
    "export:standalone": "node scripts/export-standalone.mjs",
    "export:public-root": "node scripts/export-public-root.mjs",
    "seed:standalone": "node scripts/seed-standalone.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "emulators": "firebase emulators:start --project demo-replofy-os --import=./emulator_data --export-on-exit",
    "build": "vite build",
    "build:firebase": "cross-env VITE_REPLOFY_PLATFORM=firebase vite build",
    "build:standalone": "cross-env VITE_REPLOFY_PLATFORM=standalone vite build",
    "check:standalone-bundle": "node scripts/check-standalone-bundle.mjs",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "test:api:creative-assets": "firebase emulators:exec --only auth,firestore \"node scripts/run-creative-asset-api-test.mjs\"",
    "test:cloudinary:live": "node scripts/test-creative-asset-cloudinary-live.mjs",
    "test:rules:creative-hub": "firebase emulators:exec --only auth,firestore \"node scripts/test-creative-hub-rules.mjs\"",
    "test:rules:team-invitations": "firebase emulators:exec --only auth,firestore \"node scripts/test-team-invitation-rules.mjs\"",
    "test:api:creative-hub-mcp": "firebase emulators:exec --only firestore \"npx tsx scripts/test-creative-hub-mcp-api.ts\"",
    "test:api:team-chat-mcp": "firebase emulators:exec --only firestore \"npx tsx scripts/test-team-chat-mcp-api.ts\"",
    "test:api:operator-mcp": "firebase emulators:exec --only firestore \"npx tsx scripts/test-operator-mcp-api.ts\"",
    "test:context-routing": "tsx --test src/services/contextRoutingService.test.ts",
    "test:standalone-client": "tsx --test src/services/standaloneClient.test.ts",
    "test:asset-store": "tsx --test src/server/platform/filesystem-asset-store.test.ts",
    "test:asset-store-contracts": "tsx --test src/server/platform/asset-store.contract.test.ts",
    "test:s3-asset-store": "tsx --test src/server/platform/s3-asset-store.test.ts",
    "test:s3-asset-store:integration": "tsx --test src/server/platform/s3-asset-store.integration.test.ts",
    "test:event-bus": "tsx --test src/server/platform/event-bus.test.ts",
    "test:platform-contracts": "tsx --test src/server/platform/ai-provider.test.ts src/server/platform/workspace-repository.test.ts",
    "test:ai": "tsx --test src/server/ai/settings.test.ts src/server/ai/provider-gateway.test.ts src/server/ai/context-strategy.test.ts src/server/ai/actionability.test.ts src/server/ai/types.test.ts",
    "test:mcp:hosted": "tsx --test src/services/chatgptApp/mcpServer.test.ts",
    "test:server:integration": "tsx --test src/server/bootstrap.integration.test.ts",
    "test:server:http": "tsx --test src/server/app.http.test.ts",
    "test:server:http:integration": "tsx --test src/server/http.integration.test.ts",
    "test:server:recovery": "node scripts/test-server-process-recovery.mjs",
    "test:server:database-reconnect": "node scripts/test-server-database-reconnect.mjs",
    "test:server:config": "tsx --test src/server/config.test.ts",
    "test:api-key-scopes": "tsx --test src/server/api-keys.test.ts",
    "test:postgres-cli": "node --test scripts/postgres-cli.test.mjs",
    "test:s3-client": "node --test scripts/lib/s3-client.test.mjs",
    "test:s3-integration": "node --test scripts/test-s3-integration.mjs",
    "seed:s3-fixture": "node scripts/seed-s3-fixture.mjs",
    "check:s3-fixture": "node scripts/check-s3-fixture.mjs",
    "test:smoke:mcp": "python -m unittest discover -s mcp/tests -p \"test_*.py\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@google/genai": "^1.29.0",
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-auth": "^1.6.26",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^7.4.0",
    "pdfjs-dist": "^5.5.207",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "vite": "^6.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "firebase-tools": "^15.25.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
