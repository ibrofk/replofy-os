# Copy this file to .env for the standalone server or Compose. Vite also reads
# .env; a Vite-only workflow may instead use .env.local. The Firebase values
# below are optional with local emulators and must be explicit for hosted use.

# Optional: Gemini network calls stay disabled when this is empty; the local
# bounded extraction fallback remains available.
GEMINI_API_KEY=""

# Standalone AI context engine. A workspace must still save a provider key and
# select a model in the UI before the engine becomes active.
# Provider secrets are encrypted with this instance key when set; when empty,
# the required Better Auth secret is used as the derivation source.
REPLOFY_AI_SECRETS_KEY=""
REPLOFY_AI_WORKER_ENABLED="true"
REPLOFY_MEMORY_SERVICE_TOKEN="replace-with-a-long-private-memory-token"
REPLOFY_MEMORY_DATA="D:/ReplofyData/memory"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:4000"
VITE_REPLOFY_PLATFORM="firebase"

# PostgreSQL self-hosted platform. These are consumed by the standalone server
# and can remain unset while running the temporary Firebase preview.
DATABASE_URL="postgres://replofy:change-me@127.0.0.1:5432/replofy"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
REPLOFY_BOOTSTRAP_TOKEN="replace-with-at-least-32-random-characters"
REPLOFY_DATA_DIR="./data"
# Use filesystem for zero-dependency local storage, or s3 for an S3-compatible provider.
REPLOFY_ASSET_STORE="filesystem"
REPLOFY_SERVER_URL="http://localhost:4100"
REPLOFY_TRUSTED_ORIGINS="http://localhost:4100,http://localhost:4000"
REPLOFY_SECURE_COOKIES="false"
REPLOFY_INVITATION_TTL_HOURS="168"
SERVER_HOST="127.0.0.1"
SERVER_PORT="4100"

# Optional Compose bind mounts. On Windows, use forward slashes.
# These keep persistent data off C:, but Docker's image/cache location is a
# separate Docker Desktop setting.
REPLOFY_POSTGRES_DATA="./.replofy/postgres"
REPLOFY_APP_DATA="./.replofy/data"
# Keep this outside REPLOFY_DATA_DIR; use a D:/ path when C: is tight.
REPLOFY_BACKUP_DIR="./backups"
POSTGRES_PASSWORD="replace-with-a-strong-database-password"

# Required only when REPLOFY_ASSET_STORE=s3. MinIO works with path-style URLs.
REPLOFY_S3_ENDPOINT="http://localhost:9000"
REPLOFY_S3_BUCKET="replofy-assets"
REPLOFY_S3_ACCESS_KEY_ID=""
REPLOFY_S3_SECRET_ACCESS_KEY=""
REPLOFY_S3_REGION="us-east-1"
REPLOFY_S3_FORCE_PATH_STYLE="true"
REPLOFY_S3_CREATE_BUCKET="false"

# Browser Firebase configuration. Do not commit a real project configuration.
VITE_FIREBASE_PROJECT_ID="demo-replofy-os"
VITE_FIREBASE_API_KEY="demo-replofy-os"
VITE_FIREBASE_AUTH_DOMAIN="demo-replofy-os.firebaseapp.com"
VITE_FIREBASE_APP_ID="demo-replofy-os"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIRESTORE_DATABASE_ID=""
VITE_FIRESTORE_EMULATOR_HOST="127.0.0.1:8081"
VITE_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# Firebase Admin credentials for secure server-side API routes.
# In local development, the Firebase Auth and Firestore emulators are used automatically.
# In deployment, provide either FIREBASE_SERVICE_ACCOUNT_JSON or the individual fields below.
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""
FIREBASE_DATABASE_ID=""
FIREBASE_PROJECT_ID="demo-replofy-os"
FIRESTORE_EMULATOR_HOST="127.0.0.1:8081"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# Cloudinary credentials for Creative Hub assets.
# Use CLOUDINARY_URL or the individual fields below.
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ChatGPT Apps SDK connector.
# Production should use OAuth. REPLOFY_CHATGPT_APP_API_KEY is only a controlled development fallback.
REPLOFY_CHATGPT_APP_AUTH_MODE="oauth"
REPLOFY_CHATGPT_APP_BASE_URL="http://localhost:4000"
REPLOFY_CHATGPT_APP_WIDGET_DOMAIN="http://localhost:4000"
REPLOFY_CHATGPT_APP_ALLOWED_ORIGINS="http://localhost:4000,http://localhost:4100,https://chatgpt.com,https://chat.openai.com"
REPLOFY_CHATGPT_APP_API_KEY=""
REPLOFY_CHATGPT_APP_API_KEY_FALLBACK="false"
